# Copy to .env and fill in. NEVER commit .env.

# This email address becomes admin when it registers. Leave empty for no admin.
ADMIN_EMAIL=you@example.com

# Address your ESP32 uses to reach the device API (shown on the Device page).
# Local test: http://<your-PC-IPv4>:8000     Public: https://your-api.example.com
API_BASE_URL=http://10.98.80.93:8000

# Optional: free key from https://ocr.space/ocrapi (default 'helloworld' is shared/limited)
OCR_SPACE_KEY=
# Optional: Google Fact Check Tools API key (free)
GOOGLE_FACTCHECK_KEY=

# Optional: SMTP for real password-reset emails (e.g. Gmail app password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# DEVELOPMENT ONLY: shows password-reset codes on screen. Never set to 1 on a public server.
DEV_MODE=0
